<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Install: cp this file to ~/Library/LaunchAgents/ then
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/eu.ngen.zen-to-firefox.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>eu.ngen.zen-to-firefox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/peter.paravinja/code/sync-zen-to-firefox/zen_to_firefox.py</string>
    <string>--watch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/peter.paravinja/Library/Logs/zen-to-firefox.log</string>
  <key>StandardErrorPath</key><string>/Users/peter.paravinja/Library/Logs/zen-to-firefox.log</string>
</dict>
</plist>
